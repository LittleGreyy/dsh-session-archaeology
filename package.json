{
  "name": "dsh-session-archaeology",
  "version": "0.3.0",
  "description": "会话考古：手动选中一段历史会话，离线蒸馏出可复用的 Skill。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "session",
    "distill"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "digest.js",
    "skill-store.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleGreyy/dsh-session-archaeology.git"
  },
  "homepage": "https://github.com/LittleGreyy/dsh-session-archaeology#readme",
  "bugs": {
    "url": "https://github.com/LittleGreyy/dsh-session-archaeology/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
